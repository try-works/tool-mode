{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dedupe_and_rank output",
  "description": "Output for dedupe_and_rank (MOD-10, MOD-12): the greedy representative groups in input order and the group representatives ranked against the query, computed from ONE embedding pass. A member's score is its cosine similarity to its own group's REPRESENTATIVE. `ranking` contains only representatives, in stable descending cosine order with exact ties broken by the representatives' input order. The result is deterministic for a fixed threshold and input order, is NOT transitive, and never deletes, moves or rewrites source files. `processing` carries one record per embedded item (items in input order, the query last).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups",
    "ranking",
    "threshold",
    "embeddingSpaceId",
    "processing",
    "meta"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representativeId",
          "members"
        ],
        "properties": {
          "representativeId": {
            "type": "string",
            "minLength": 1,
            "description": "The first item of the group, which every member score is relative to."
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "score"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "description": "Cosine similarity to this group's representative; the representative itself is first with a score of exactly 1."
                }
              }
            }
          }
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "A group representative's id, preserved verbatim and never renumbered (MOD-10)."
          },
          "score": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "description": "Cosine similarity between the query and this representative. Exact ties are broken by the representatives' input order, deterministically."
          }
        }
      }
    },
    "threshold": {
      "type": "number",
      "exclusiveMinimum": -1,
      "exclusiveMaximum": 1,
      "description": "The threshold the reported grouping used, echoed so the result cannot be read as a different policy."
    },
    "embeddingSpaceId": {
      "type": "string",
      "minLength": 1,
      "description": "The space every item and the query were embedded in (MOD-03)."
    },
    "processing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/processing"
      },
      "description": "One record per embedded item: the items in input order, then the query."
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional envelope for a host or caller that stamps provenance; the shared envelope is supplied by the host when a contract declares it required."
    }
  },
  "$defs": {
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modalities",
        "sourceRanges",
        "sampledVideoFrames",
        "observedAudioSampleRates",
        "truncated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "code",
              "image",
              "audio",
              "video"
            ]
          }
        },
        "sourceRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "partIndex",
              "range"
            ],
            "properties": {
              "partIndex": {
                "type": "integer",
                "minimum": 0
              },
              "range": {
                "$ref": "#/$defs/timeRange"
              }
            }
          }
        },
        "sampledVideoFrames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "partIndex",
              "timestampsSeconds"
            ],
            "properties": {
              "partIndex": {
                "type": "integer",
                "minimum": 0
              },
              "timestampsSeconds": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "observedAudioSampleRates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "partIndex",
              "sourceHz",
              "modelHz"
            ],
            "properties": {
              "partIndex": {
                "type": "integer",
                "minimum": 0
              },
              "sourceHz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "modelHz": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "truncated": {
          "const": false,
          "description": "Always false in v1: an over-context item is rejected rather than silently shortened (MOD-08)."
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSeconds",
        "endSeconds"
      ],
      "properties": {
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "endSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}