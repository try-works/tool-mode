{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mirage_extract output",
  "description": "Constrained form values with the engine’s native probabilities. The values are model predictions, not ground truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fields",
    "language",
    "meta"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "null"
            ]
          },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "probability"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "probability": {
                  "type": "number"
                }
              }
            }
          },
          "probability": {
            "type": "number"
          }
        }
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de",
        "fr",
        "es",
        "it",
        "nl",
        "pl"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contractVersion",
        "implementationId",
        "extension",
        "extensionVersion",
        "activationGeneration",
        "executionLocation",
        "receiptId",
        "warnings"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        },
        "extensionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "executionLocation": {
          "type": "string",
          "enum": [
            "host",
            "device",
            "team-server",
            "remote"
          ]
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contractVersion",
        "implementationId",
        "extension",
        "extensionVersion",
        "activationGeneration",
        "executionLocation",
        "receiptId",
        "warnings"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        },
        "extensionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "executionLocation": {
          "type": "string",
          "enum": [
            "host",
            "device",
            "team-server",
            "remote"
          ]
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
