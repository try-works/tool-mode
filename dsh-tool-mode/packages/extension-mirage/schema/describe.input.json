{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mirage_describe input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Host-authorized local image path. The extension resolves it through the host path broker; a path-only string is never opened directly."
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de",
        "fr",
        "es",
        "it",
        "nl",
        "pl"
      ],
      "description": "Description language the released model documents."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "scene",
          "objects",
          "text",
          "relations",
          "reasoning"
        ]
      },
      "description": "Sections to return; omitted means all five."
    },
    "maxObjects": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "maxTextLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "textConf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
