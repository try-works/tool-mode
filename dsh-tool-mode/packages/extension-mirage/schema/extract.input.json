{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mirage_extract input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "fields"
  ],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Host-authorized local image path. The extension resolves it through the host path broker; a path-only string is never opened directly."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "enum",
              "integer",
              "string",
              "box"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "of": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "For kind box: an earlier enum field whose object box is returned as [x1,y1,x2,y2]."
          }
        }
      },
      "description": "Ordered form fields: enum choices, bounded integers, or short strings."
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de",
        "fr",
        "es",
        "it",
        "nl",
        "pl"
      ],
      "description": "Description language the released model documents."
    }
  }
}
