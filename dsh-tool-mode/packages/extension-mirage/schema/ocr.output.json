{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mirage_ocr output",
  "description": "Text regions with boxes and detection scores. This is OCR, not a claim of perfect transcription: low scores and clipped regions are possible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "meta"
  ],
  "properties": {
    "text": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "string",
          "bbox",
          "score"
        ],
        "properties": {
          "string": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            },
            "description": "[x1,y1,x2,y2] on the model 0..1000 scale."
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contractVersion",
        "implementationId",
        "extension",
        "extensionVersion",
        "activationGeneration",
        "executionLocation",
        "receiptId",
        "warnings"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        },
        "extensionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "executionLocation": {
          "type": "string",
          "enum": [
            "host",
            "device",
            "team-server",
            "remote"
          ]
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contractVersion",
        "implementationId",
        "extension",
        "extensionVersion",
        "activationGeneration",
        "executionLocation",
        "receiptId",
        "warnings"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        },
        "extensionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "executionLocation": {
          "type": "string",
          "enum": [
            "host",
            "device",
            "team-server",
            "remote"
          ]
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
