{
  "protocolVersion": "1.1.0",
  "id": "@try-works/extension-shapes-recipe",
  "version": "0.1.1",
  "displayName": "Shapes stroke recognition (declarative)",
  "description": "Ships NO CODE. Declares the Desert Ant Labs Shapes LiteRT artifact and one model-runtime recipe, so the host's declarative lane registers shape_recognize from data alone.",
  "license": "Apache-2.0",
  "activation": {
    "policy": "operator",
    "deactivatable": true
  },
  "runtimeApi": 1,
  "compatibility": {
    "hostApi": "^1.1.0",
    "requiredFeatures": [
      "declarative-recipes-v1",
      "verified-assets-v1"
    ]
  },
  "execution": {
    "kind": "declarative"
  },
  "permissions": {
    "networkOrigins": [],
    "inputFiles": false,
    "storage": "none",
    "secrets": [],
    "nativeCode": false
  },
  "models": [
    {
      "id": "shapes",
      "assetSet": "shapes-litert",
      "assetLock": "./models.lock.json",
      "platforms": [
        {
          "os": "win32",
          "arch": "x64",
          "accelerator": "cpu"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "shape-recognize",
      "name": "shape_recognize",
      "contractId": "@try-works/extension-shapes-recipe/shape_recognize",
      "contractVersion": "1.0.0",
      "description": "Recognize a single hand-drawn stroke as one of the Shapes classes and return the ranked candidates with confidences.",
      "inputSchema": "./schemas/shape.input.json",
      "outputSchema": "./schemas/shape.output.json"
    }
  ],
  "implementations": [
    {
      "id": "shape-recognize",
      "contractId": "@try-works/extension-shapes-recipe/shape_recognize",
      "contractVersion": "1.0.0",
      "modelId": "shapes",
      "recipeVersion": "1.0.0"
    }
  ],
  "skills": [
    {
      "id": "shape-recognize",
      "name": "shape-recognize",
      "description": "Use shape_recognize to snap a single hand-drawn stroke to a clean shape class before fitting or drawing geometry.",
      "path": "./skills/shape-recognize/SKILL.md",
      "requiresTools": [
        "shape-recognize"
      ]
    }
  ],
  "licenses": [
    {
      "layer": "code",
      "name": "Apache License 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": true,
      "attributionText": "Copyright the Tool Mode contributors",
      "obligations": [
        "preserve the license and NOTICE files"
      ]
    },
    {
      "layer": "engine",
      "name": "LiteRT.js (@litertjs/core 2.5.3), Apache-2.0",
      "url": "https://github.com/google-ai-edge/LiteRT",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": true,
      "attributionText": "Google LiteRT",
      "obligations": [
        "preserve the LiteRT.js license notices"
      ]
    },
    {
      "layer": "weights",
      "name": "Desert Ant Labs Source-Available License 1.0",
      "url": "https://license.desertant.com/1.0",
      "openSource": false,
      "redistribution": "not-permitted",
      "attributionRequired": true,
      "attributionText": "Powered by Desert Ant Labs",
      "obligations": [
        "display the attribution notice with a link to Desert Ant Labs",
        "a commercial licence is required above the per-platform, per-model active-device threshold",
        "do not redistribute the model, SDK or a hosted service as a standalone product",
