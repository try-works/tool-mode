{
  "kind": "model-runtime",
  "schemaVersion": 1,
  "provider": {
    "package": "@try-works/tool-mode-runtime-litert",
    "export": "createProviderFromRecipe",
    "accelerators": [
      "cpu"
    ]
  },
  "model": {
    "assetSet": "shapes-litert",
    "fileName": "shapes.tflite",
    "format": "tflite"
  },
  "processor": {
    "id": "shapes/points-v1"
  },
  "limits": {
    "maxInputBytes": 4194304,
    "timeoutMs": 120000
  },
  "tool": {
    "name": "shape_recognize",
    "description": "Recognize a single hand-drawn stroke as one of the Shapes classes and return the ranked candidates with confidences.",
    "inputSchema": "./schemas/shape.input.json",
    "outputSchema": "./schemas/shape.output.json"
  }
}
