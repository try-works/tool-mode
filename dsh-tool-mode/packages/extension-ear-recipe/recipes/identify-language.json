{
  "kind": "model-runtime",
  "schemaVersion": 1,
  "provider": {
    "package": "@try-works/tool-mode-runtime-litert",
    "export": "createProviderFromRecipe",
    "accelerators": [
      "cpu"
    ]
  },
  "model": {
    "assetSet": "ear-litert",
    "fileName": "ear.tflite",
    "format": "tflite"
  },
  "processor": {
    "id": "ear/mel-v1"
  },
  "limits": {
    "maxInputBytes": 4194304,
    "timeoutMs": 300000
  },
  "tool": {
    "name": "identify_language",
    "description": "Identify the spoken language of an audio recording on device: the most likely language, its confidence, a reliability flag and the top candidates.",
    "inputSchema": "./schemas/identify-language.input.json",
    "outputSchema": "./schemas/identify-language.output.json"
  }
}
